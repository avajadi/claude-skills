# Settings for the CI and release workflows: the one file to edit for your plug-in.
#
# Every workflow loads this file into its environment, so the values must be plain KEY=value lines.
# Don't quote them: spaces are fine and quotes would become part of the value. Lines starting with # and empty
# lines are skipped.

# The target name given to juce_add_plugin(). JUCE names the format targets <target>_VST3, <target>_AU and so on,
# and puts the built plug-ins in <build dir>/<target>_artefacts/Release.
PLUGIN_TARGET=MyPlugin

# PRODUCT_NAME from juce_add_plugin(): the file names of the bundles ("My Plugin.vst3").
PRODUCT_NAME=My Plugin

# Prefix for the zips and the installer. No spaces.
PACKAGE_NAME=MyPlugin

# COMPANY_NAME from juce_add_plugin(); shown in the installer.
COMPANY_NAME=My Company

# Your unit-test executable's target, built and run with ctest. Leave empty when there are no tests.
TEST_TARGET=MyPluginTests

# true to build, validate and ship CLAP as well (needs clap-juce-extensions, or a JUCE version with CLAP).
BUILD_CLAP=false

# For auval, from juce_add_plugin(): AU_TYPE is aufx for an effect, aumu for an instrument, aumf for an effect that
# takes MIDI. PLUGIN_CODE is PLUGIN_CODE and MANUFACTURER_CODE is PLUGIN_MANUFACTURER_CODE.
AU_TYPE=aufx
PLUGIN_CODE=Mypl
MANUFACTURER_CODE=Mnfr

# The Windows installer's identity. Generate a GUID once (PowerShell: [guid]::NewGuid(), Linux: uuidgen) and never
# change it again: it's how upgrades and the uninstaller recognise the product. No braces.
INSTALLER_APP_ID=00000000-0000-0000-0000-000000000000

# Extra arguments for the release builds' CMake configure step, e.g. -DMYPLUGIN_COPY_AFTER_BUILD=OFF.
CMAKE_EXTRA_ARGS=
