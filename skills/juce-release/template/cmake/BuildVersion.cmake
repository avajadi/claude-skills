# Writes the build's version header. Runs at build time (cmake -P) so the commit hash is always current.
#
#   -DVERSION=<x.y.z> -DSOURCE_DIR=<repo> -DOUTPUT=<header>
#
# Release build: HEAD is exactly at tag v<VERSION> and tracked files are unmodified -> "x.y.z".
# Anything else is a dev build -> "x.y.z-dev+<hash>" (".dirty" appended when tracked files are modified),
# or "x.y.z-dev" when git isn't available.

find_package(Git QUIET)

set(dev 1)
set(full "${VERSION}-dev")

if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE hash RESULT_VARIABLE hash_result
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

    if(hash_result EQUAL 0)
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE changes ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" describe --tags --exact-match --match "v${VERSION}" HEAD
            WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE tag_result OUTPUT_QUIET ERROR_QUIET)

        if(tag_result EQUAL 0 AND changes STREQUAL "")
            set(dev 0)
            set(full "${VERSION}")
        else()
            set(full "${VERSION}-dev+${hash}")
            if(NOT changes STREQUAL "")
                string(APPEND full ".dirty")
            endif()
        endif()
    endif()
endif()

set(content "// Generated by cmake/BuildVersion.cmake. Do not edit.
#pragma once
#define PLUGIN_VERSION \"${VERSION}\"
#define PLUGIN_VERSION_FULL \"${full}\"
#define PLUGIN_DEV_BUILD ${dev}
")

# Only touch the file when it changes, so an unchanged version doesn't trigger recompiles.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT "${existing}" STREQUAL "${content}")
    file(WRITE "${OUTPUT}" "${content}")
    message(STATUS "Plugin version: ${full}")
endif()
